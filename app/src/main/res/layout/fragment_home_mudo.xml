<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header Section -->
    <View
        android:id="@+id/header_background"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_welcome_mudo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:text="@string/hello_user"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/card_settings_mudo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Hola, María" />

    <TextView
        android:id="@+id/tv_mode_mudo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/mode_mute"
        android:textColor="@color/gray_100"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/tv_welcome_mudo"
        app:layout_constraintStart_toStartOf="@+id/tv_welcome_mudo"
        app:layout_constraintTop_toBottomOf="@+id/tv_welcome_mudo" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_settings_mudo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#2A4CB0"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_mode_mudo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_welcome_mudo">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/menu_settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/white" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Recent Phrases Section -->
    <TextView
        android:id="@+id/tv_recent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/recent_phrases"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_mode_mudo" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recent_phrases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/tv_recent_label"
        tools:listitem="@layout/item_symbol" />

    <!-- 12 AAC Symbols Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_quick_symbols"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar_mudo"
        app:layout_constraintTop_toBottomOf="@+id/header_background"
        tools:listitem="@layout/item_symbol" />

    <!-- Bottom Quick Text Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_bar_mudo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/et_quick_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_speak"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_speak_mudo"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/btn_speak_content_desc"
                app:cornerRadius="28dp"
                app:icon="@android:drawable/ic_btn_speak_now"
                app:iconSize="28dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- FAB for Full Board -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_full_board"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/fab_symbols_content_desc"
        android:text="Tablero"
        android:textColor="@color/white"
        app:backgroundTint="@color/secondary"
        app:icon="@drawable/ic_chat_bubble"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar_mudo"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
