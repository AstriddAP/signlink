<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.signlink.ui.onboarding.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.signlink.ui.onboarding.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_setup"
            app:destination="@id/setupFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/setupFragment"
        android:name="com.signlink.ui.onboarding.SetupFragment"
        android:label="Seleccionar Perfil"
        tools:layout="@layout/fragment_setup">
        <action
            android:id="@+id/action_setup_to_home_auditivo"
            app:destination="@id/nav_home"
            app:popUpTo="@id/setupFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_setup_to_home_mudo"
            app:destination="@id/nav_home_mudo"
            app:popUpTo="@id/setupFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.signlink.ui.home.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_home_mudo"
        android:name="com.signlink.ui.home.HomeMudoFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home_mudo" />

    <fragment
        android:id="@+id/nav_communicate"
        android:name="com.signlink.ui.communicate.CommunicateFragment"
        android:label="Comunicar"
        tools:layout="@layout/fragment_communicate" />

    <fragment
        android:id="@+id/nav_alerts"
        android:name="com.signlink.ui.alerts.AlertsFragment"
        android:label="Alertas"
        tools:layout="@layout/fragment_alerts" />

    <fragment
        android:id="@+id/nav_map"
        android:name="com.signlink.ui.map.MapFragment"
        android:label="Mapa"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/nav_nfc"
        android:name="com.signlink.ui.nfc.NFCFragment"
        android:label="NFC"
        tools:layout="@layout/fragment_nfc" />

    <fragment
        android:id="@+id/nav_contacts"
        android:name="com.signlink.ui.contacts.ContactsFragment"
        android:label="Contactos"
        tools:layout="@layout/fragment_contacts" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.signlink.ui.profile.SettingsFragment"
        android:label="Ajustes"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/nav_live_captioning"
        android:name="com.signlink.ui.captioning.LiveCaptioningFragment"
        android:label="Subtítulos en Vivo"
        tools:layout="@layout/fragment_live_captioning" />

    <fragment
        android:id="@+id/nav_documents"
        android:name="com.signlink.ui.documents.DocumentListFragment"
        android:label="Mis Documentos"
        tools:layout="@layout/fragment_document_list">
        <action
            android:id="@+id/action_nav_documents_to_addDocument"
            app:destination="@id/nav_add_document" />
        <action
            android:id="@+id/action_nav_documents_to_viewDni"
            app:destination="@id/nav_view_dni" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_document"
        android:name="com.signlink.ui.documents.AddDocumentFragment"
        android:label="Agregar Documento"
        tools:layout="@layout/fragment_add_document" />

    <fragment
        android:id="@+id/nav_view_dni"
        android:name="com.signlink.ui.documents.ViewDniFragment"
        android:label="Ver DNI"
        tools:layout="@layout/fragment_view_dni">
        <argument
            android:name="documentId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/nav_notes"
        android:name="com.signlink.ui.notes.NoteListFragment"
        android:label="Notas Seguras"
        tools:layout="@layout/fragment_note_list">
        <action
            android:id="@+id/action_nav_notes_to_addNote"
            app:destination="@id/nav_add_note" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_note"
        android:name="com.signlink.ui.notes.AddNoteFragment"
        android:label="Nueva Nota"
        tools:layout="@layout/fragment_add_note" />

    <fragment
        android:id="@+id/nav_ai_explanation"
        android:name="com.signlink.ui.ai.AiExplanationFragment"
        android:label="Simplificador IA"
        tools:layout="@layout/fragment_ai_explanation" />

    <fragment
        android:id="@+id/nav_news"
        android:name="com.signlink.ui.news.NewsFragment"
        android:label="Noticias IA"
        tools:layout="@layout/fragment_news" />

    <fragment
        android:id="@+id/nav_video_capture"
        android:name="com.signlink.ui.video.VideoCaptureFragment"
        android:label="Grabar con Subtítulos"
        tools:layout="@layout/fragment_video_capture" />

    <fragment
        android:id="@+id/nav_audio_transcription"
        android:name="com.signlink.ui.captioning.AudioTranscriptionFragment"
        android:label="Transcripción de Audio"
        tools:layout="@layout/fragment_audio_transcription">
        <argument
            android:name="audio_uri"
            app:argType="string" />
    </fragment>

</navigation>
