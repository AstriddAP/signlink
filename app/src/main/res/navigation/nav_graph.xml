<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.signlink.ui.onboarding.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.signlink.ui.onboarding.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.signlink.ui.home.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_communicate"
        android:name="com.signlink.ui.communicate.CommunicateFragment"
        android:label="Comunicar"
        tools:layout="@layout/fragment_communicate" />


    <fragment
        android:id="@+id/nav_settings"
        android:name="com.signlink.ui.profile.SettingsFragment"
        android:label="Ajustes"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/nav_live_captioning"
        android:name="com.signlink.ui.captioning.LiveCaptioningFragment"
        android:label="Subtítulos en Vivo"
        tools:layout="@layout/fragment_live_captioning" />


    <fragment
        android:id="@+id/nav_ai_explanation"
        android:name="com.signlink.ui.ai.AiExplanationFragment"
        android:label="Simplificador IA"
        tools:layout="@layout/fragment_ai_explanation" />


    <fragment
        android:id="@+id/nav_audio_transcription"
        android:name="com.signlink.ui.captioning.AudioTranscriptionFragment"
        android:label="Transcripción de Audio"
        tools:layout="@layout/fragment_audio_transcription">
        <argument
            android:name="audio_uri"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_visual_dictionary"
        android:name="com.signlink.ui.dictionary.VisualDictionaryFragment"
        android:label="Diccionario LSP"
        tools:layout="@layout/fragment_visual_dictionary" />

</navigation>
