<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme para Modo Oscuro -->
    <style name="Base.Theme.SignLink" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Principales -->
        <item name="colorPrimary">#5C8AFF</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>

        <!-- Fondos y Superficies para Modo Oscuro -->
        <item name="android:windowBackground">@color/dark_blue_bg</item>
        <item name="colorSurface">@color/dark_blue_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">#B0B8D0</item>
        <item name="android:navigationBarColor">@color/dark_blue_bg</item>

        <!-- Colores de Tarjetas Adaptados para Oscuro -->
        <item name="colorSurfaceVariant">@color/dark_blue_surface_variant</item>
        <item name="colorPrimaryContainer">#1E2942</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
    </style>

    <style name="Theme.SignLink" parent="Base.Theme.SignLink" />
</resources>
