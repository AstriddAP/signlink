<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SignLink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/gray_100</item>
        <item name="colorPrimaryContainer">#E3F2FD</item>
        <item name="colorOnPrimaryContainer">@color/primary_variant</item>
    </style>

    <style name="Theme.SignLink" parent="Base.Theme.SignLink" />

    <style name="Theme.SignLink.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.SignLink.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ShapeAppearance.SignLink.LargeCard" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.SignLink.PanicButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/panic_red</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SignLink.LargeCard</item>
    </style>
</resources>
